# Copier en .env puis remplir les valeurs : cp .env.example .env
# Toutes les variables applicatives sont préfixées GENAI_ (voir src/genai_platform/config.py)

# --- Provider LLM (LiteLLM lit ces clés directement, sans préfixe GENAI_) ---
# Pour utiliser OpenRouter (chat completion uniquement, pas d'embeddings) :
OPENROUTER_API_KEY=

# --- Gateway LLM ---
# Modèles au format LiteLLM. Pour OpenRouter : "openrouter/<provider>/<modele>"
# ex: openrouter/openai/gpt-4o-mini, openrouter/anthropic/claude-3.5-sonnet
GENAI_LLM_DEFAULT_MODEL=openrouter/openai/gpt-4o-mini
GENAI_LLM_FALLBACK_MODELS=["openrouter/anthropic/claude-3.5-sonnet"]
GENAI_LLM_TEMPERATURE=0.1
GENAI_LLM_MAX_TOKENS=2048
GENAI_LLM_REQUEST_TIMEOUT=30

# --- RAG ---
# OpenRouter ne fait pas d'embeddings : sans clé OpenAI directe ici, les
# embeddings resteront en mode mock (déterministe, pas de vrai LLM).
# OPENAI_API_KEY=
GENAI_RAG_EMBEDDING_MODEL=text-embedding-3-large
GENAI_QDRANT_URL=http://localhost:6333

# --- Cache / Redis ---
GENAI_REDIS_URL=redis://localhost:6379/0

# --- Observabilité (optionnel, dégradation silencieuse si vide) ---
GENAI_LANGFUSE_HOST=http://localhost:3000
GENAI_LANGFUSE_PUBLIC_KEY=
GENAI_LANGFUSE_SECRET_KEY=

# --- Auth API (vide = auth désactivée) ---
GENAI_API_KEYS=[]
